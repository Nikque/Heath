#
# makefile
#
# Compilation options for Microsoft Visual C++ & nmake.
#
# If you have a CPU supporting popcount (Intel Nehalem (i7) or AMD Barcelona or greater),
# add /D POPCOUNT to the compiler option set.
#

# /d1trimfile removes the build folder ($(MAKEDIR), the src folder) from __FILE__:
# the error messages name only the source file, and the programs hold no build folder.

# Microsoft Visual C++ 2008 or better for Windows (7 or Vista).
# VC_FLAGS = /source-charset:.1252 /execution-charset:.1252\
# Boost (headers only): third_party/boost_1_92_0 next to the repository, or BOOST_DIR=<directory>
!IFNDEF BOOST_DIR
BOOST_DIR = ..\..\third_party\boost_1_92_0
!ENDIF
VC_FLAGS = /I"$(BOOST_DIR)" /std:c++23preview /Zc:__cplusplus /EHs-c- /D _HAS_EXCEPTIONS=0 /GR- /D UNICODE /utf-8 /D _CRT_SECURE_NO_DEPRECATE /I"..\include" /I. /O2 /fp:fast /GS- /D NDEBUG /MT "/d1trimfile:$(MAKEDIR)\\"
# EVAL_SLOTS=48 builds the 48 slots (default 64, src/eval/eval.h): nmake -f NMakefile EVAL_SLOTS=48 <target>.
# PGO_SLOTS is the slot count written by pgo-record.cmd; /D EVAL_SLOTS in the CL variable is refused
# (the record would not see it).
!IF "$(CL:EVAL_SLOTS=)" != "$(CL)"
!ERROR give the slots as EVAL_SLOTS=<48|64> on the nmake command line, not in the CL variable
!ENDIF
!IFDEF EVAL_SLOTS
VC_FLAGS = $(VC_FLAGS) /D EVAL_SLOTS=$(EVAL_SLOTS)
PGO_SLOTS = $(EVAL_SLOTS)
!ELSE
PGO_SLOTS = 64
!ENDIF

