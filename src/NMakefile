# Profile-guided builds (used for the release binaries): an instrumented build is trained
# on single-thread runs (so the profile is reproducible), then linked again with the profile.
# The two profile runs of a program are two command lines: two processes, one after the other.
# Build the x86 targets from a native x86 prompt (vcvarsall x86): the instrumented exe needs the x86 pgort140.dll.
# PGO_EVAL: the eval.dat that the profile runs read (an absolute path; the default is bin\data\eval.dat,
# the one of eval2: give the eval.dat of the release of EVAL_SLOTS). pgo-record.cmd writes its SHA-256 in
# ..\bin\pgo-build.txt with the SHA-256 of the program, the commit and PGO_SLOTS (package-release.py checks them).
!IFNDEF PGO_EVAL
PGO_EVAL = $(MAKEDIR)\..\bin\data\eval.dat
!ENDIF
PGO_SOLVE = -n 1 -l 60 -eval-file "$(PGO_EVAL)" -solve ..\problem\fforum-20-39.obf
PGO_PLAY = -n 1 -l 18 -eval-file "$(PGO_EVAL)" -auto-store on -auto-start on -repeat 4 -auto-quit on -mode 2 -book-file book.pgo < nul

vc-pgo-x64-v4:
	if not exist ..\bin mkdir ..\bin
	cl $(VC_FLAGS) /GL /D HAS_CPU_64 /arch:AVX512 /vlen=256 /D POPCOUNT all.cpp ws2_32.lib /Fe..\bin\wEdax-x86-64-v4.exe /link /LTCG:PGI /VERSION:4.5
	cd ..\bin && .\wEdax-x86-64-v4.exe $(PGO_SOLVE) >nul
	cd ..\bin && .\wEdax-x86-64-v4.exe $(PGO_PLAY) >nul
	-del ..\bin\book.pgo ..\bin\book.pgo.store 2>nul
	link /nologo all.obj ws2_32.lib /out:..\bin\wEdax-x86-64-v4.exe /LTCG:PGO /PGD:..\bin\wEdax-x86-64-v4.pgd /VERSION:4.5
	cmd /c .\pgo-record.cmd ..\bin\wEdax-x86-64-v4.exe "$(PGO_EVAL)" $(PGO_SLOTS)
	del ..\bin\wEdax-x86-64-v4*.pgc ..\bin\wEdax-x86-64-v4.pgd
	copy /Y ..\config.ini ..\bin\config.ini

