# Library (libedax): Edax as a dll with the api of src\libedax.h, for the programs written for
# libedax (libedax4dart, edax_runner). These programs load libedax-x64.dll; edax_runner loads
# libedax-x64-v3.dll or libedax-x64-v4.dll instead when the CPU supports it (libedax_cpu_level).
VC_LIB_FLAGS = $(VC_FLAGS) /GL /D HAS_CPU_64 /D LIB_BUILD /LD

vc-lib-x64-v4:
	if not exist ..\bin mkdir ..\bin
	cl $(VC_LIB_FLAGS) /arch:AVX512 /vlen=256 /D POPCOUNT all.cpp ws2_32.lib /Fe..\bin\libedax-x64-v4.dll /link /VERSION:4.5 /IMPLIB:libedax-x64-v4.lib
	del libedax-x64-v4.lib libedax-x64-v4.exp

vc-lib-x64-v3:
	if not exist ..\bin mkdir ..\bin
	cl $(VC_LIB_FLAGS) /arch:AVX2 /D POPCOUNT all.cpp ws2_32.lib /Fe..\bin\libedax-x64-v3.dll /link /VERSION:4.5 /IMPLIB:libedax-x64-v3.lib
	del libedax-x64-v3.lib libedax-x64-v3.exp

vc-lib-x64:
	if not exist ..\bin mkdir ..\bin
	cl $(VC_LIB_FLAGS) all.cpp ws2_32.lib /Fe..\bin\libedax-x64.dll /link /VERSION:4.5 /IMPLIB:libedax-x64.lib
	del libedax-x64.lib libedax-x64.exp

vc-lib: vc-lib-x64 vc-lib-x64-v3 vc-lib-x64-v4

# Profile-guided builds of the library (used for the release dlls), from an x64 prompt. Each dll is built
# with /LTCG:PGI in its own folder of ..\tests\libedax\pgo (with data\eval.dat, a copy of PGO_EVAL), then
# tests\libedax_test.c is linked with its import library and run there twice, each run its own process:
# the search of "libedax_test <dll> bench 20 1" (one thread), then the whole api test (a failure stops the
# build; its output is libedax_test-pgi.log). The dll is linked again with /LTCG:PGO and copied to ..\bin.
PGO_LIB = ..\tests\libedax\pgo

vc-pgo-lib-x64-v4:
	if not exist ..\bin mkdir ..\bin
	if exist $(PGO_LIB)\x64-v4 rmdir /s /q $(PGO_LIB)\x64-v4
	mkdir $(PGO_LIB)\x64-v4\data
	copy /Y "$(PGO_EVAL)" $(PGO_LIB)\x64-v4\data\eval.dat
	cl $(VC_LIB_FLAGS) /arch:AVX512 /vlen=256 /D POPCOUNT all.cpp ws2_32.lib /Fo$(PGO_LIB)\x64-v4\all.obj /Fe$(PGO_LIB)\x64-v4\libedax-x64-v4.dll /link /LTCG:PGI /PGD:$(PGO_LIB)\x64-v4\libedax-x64-v4.pgd /VERSION:4.5 /IMPLIB:$(PGO_LIB)\x64-v4\libedax-x64-v4.lib
	cl /nologo /utf-8 /O1 /MT /D_CRT_SECURE_NO_DEPRECATE ..\tests\libedax_test.c $(PGO_LIB)\x64-v4\libedax-x64-v4.lib /Fo$(PGO_LIB)\x64-v4\libedax_test.obj /Fe$(PGO_LIB)\x64-v4\libedax_test.exe
	cd $(PGO_LIB)\x64-v4 && .\libedax_test.exe libedax-x64-v4.dll bench 20 1
	cd $(PGO_LIB)\x64-v4 && (.\libedax_test.exe libedax-x64-v4.dll > libedax_test-pgi.log 2>&1 || (type libedax_test-pgi.log & exit 1))
	findstr /c:" checks, " $(PGO_LIB)\x64-v4\libedax_test-pgi.log
	link /nologo /DLL $(PGO_LIB)\x64-v4\all.obj ws2_32.lib /out:$(PGO_LIB)\x64-v4\libedax-x64-v4.dll /LTCG:PGO /PGD:$(PGO_LIB)\x64-v4\libedax-x64-v4.pgd /VERSION:4.5 /IMPLIB:$(PGO_LIB)\x64-v4\libedax-x64-v4.lib
	copy /Y $(PGO_LIB)\x64-v4\libedax-x64-v4.dll ..\bin\libedax-x64-v4.dll
	cmd /c .\pgo-record.cmd ..\bin\libedax-x64-v4.dll "$(PGO_EVAL)" $(PGO_SLOTS)

vc-pgo-lib-x64-v3:
	if not exist ..\bin mkdir ..\bin
	if exist $(PGO_LIB)\x64-v3 rmdir /s /q $(PGO_LIB)\x64-v3
	mkdir $(PGO_LIB)\x64-v3\data
